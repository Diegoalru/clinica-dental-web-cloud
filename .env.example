# Plantilla de las variables de entorno. Copiar a .env (no se versiona) y ajustar los valores.
# Solo las variables con prefijo API_ llegan al navegador (ver vite.config.js).
# Aquí no van secretos: todo lo que se define queda visible en el JavaScript publicado.

# URL base del API, incluida la versión
API_BASE_URL=http://localhost:5125/api/v1

# Tiempo máximo de espera por solicitud, en milisegundos
API_TIMEOUT=15000
