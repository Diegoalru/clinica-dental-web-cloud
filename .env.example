# Copiar a .env y ajustar. Solo las variables con prefijo API_ llegan al navegador (ver vite.config.js).
# Aquí no van secretos: todo lo que se define en este archivo queda visible en el JavaScript publicado.

# URL base del API, incluida la versión.
# - `dotnet run` del API:      http://localhost:5125/api/v1
# - API en Docker (-p 8080:8080): http://localhost:8080/api/v1
# El API debe tener este origen del frontend (http://localhost:5173) en Cors:AllowedOrigins.
API_BASE_URL=http://localhost:5125/api/v1

# Tiempo máximo de espera por solicitud, en milisegundos
API_TIMEOUT=15000
